# Application Configuration
PORT=3000
NODE_ENV=development

# Postgres Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_MULTIPLE_DATABASES=demands,keycloak
DATABASE_URL=postgresql://user:password@localhost:5432/demands

# OIDC Configuration (JWT validation)
OIDC_DISCOVERY_URL=http://localhost:8080/realms/demands/.well-known/openid-configuration
AUTH_AUDIENCE=demands-api
AUTH_GROUP_CLAIM_PATH=groups
AUTH_ADMIN_GROUP=admin
AUTH_MODERATOR_GROUP=moderator

# Auth Client Configuration
AUTH_CLIENT_TYPE=keycloak

# Keycloak Auth Client
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=demands
KEYCLOAK_CLIENT_ID=demands-api
KEYCLOAK_CLIENT_SECRET=demands-api-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Custom Auth Client (when AUTH_CLIENT_TYPE=custom)
CUSTOM_AUTH_CLIENT_URL=
CUSTOM_AUTH_CLIENT_API_KEY=

# =============================================================================
# ENVIRONMENT VARIABLE DOCUMENTATION
# =============================================================================

# PORT - The port on which the server will run (default: 3000)
# NODE_ENV - The environment mode: development, production, or test

# POSTGRES_USER - PostgreSQL database username
# POSTGRES_PASSWORD - PostgreSQL database password
# POSTGRES_MULTIPLE_DATABASES - Comma-separated list of databases to create
# DATABASE_URL - Full PostgreSQL connection string

# OIDC_DISCOVERY_URL - OpenID Connect discovery endpoint URL
# AUTH_AUDIENCE - Expected audience claim in JWT tokens
# AUTH_GROUP_CLAIM_PATH - Path to groups claim in JWT token
# AUTH_ADMIN_GROUP - Name of the admin group for authorization
# AUTH_MODERATOR_GROUP - Name of the moderator group for authorization

# AUTH_CLIENT_TYPE - Type of auth client: 'keycloak' or 'custom'

# KEYCLOAK_URL - Base URL of Keycloak server
# KEYCLOAK_REALM - Keycloak realm name
# KEYCLOAK_CLIENT_ID - Keycloak client ID for the application
# KEYCLOAK_CLIENT_SECRET - Keycloak client secret
# KEYCLOAK_ADMIN_USERNAME - Keycloak bootstrap admin username
# KEYCLOAK_ADMIN_PASSWORD - Keycloak bootstrap admin password

# CUSTOM_AUTH_CLIENT_URL - URL for custom auth client (when AUTH_CLIENT_TYPE=custom)
# CUSTOM_AUTH_CLIENT_API_KEY - API key for custom auth client
