# Demands Deployment Configuration Template
# Copy this file to .env and fill in the actual values for your environment

# ============================================================================
# APP
# ============================================================================

# Express server listen port. Default: 3000
PORT=3000

# Runtime environment. Options: development | production | test
# In production, database seeding is skipped (must be run manually)
NODE_ENV=production

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL superuser username. Used by both the app and Keycloak
# Default dev value: user
POSTGRES_USER=postgres

# PostgreSQL superuser password. MUST be changed in production!
# Default dev value: password
POSTGRES_PASSWORD=your_secure_db_password_here

# Databases to auto-create on first Postgres startup (comma-separated)
# Default: demands,keycloak
POSTGRES_MULTIPLE_DATABASES=demands,keycloak

# Prisma datasource URL for the Demands database
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# In Docker Compose: use 'postgres' hostname (internal); externally use actual IP or hostname
# Example: postgresql://postgres:password@localhost:5432/demands
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/demands

# ============================================================================
# OIDC / JWT VALIDATION (OpenID Connect Discovery)
# ============================================================================

# OIDC discovery endpoint used by the server to fetch the JWKS (public signing keys)
# In Docker Compose: use 'keycloak' hostname for internal DNS resolution
# External URL will be rewritten internally for Docker network access
# Example: http://keycloak:8080/realms/demands/.well-known/openid-configuration
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/demands/.well-known/openid-configuration

# JWT issuer claim to validate. Must match the 'iss' in the token.
# This is the public URL of your Keycloak server (external clients use this)
# Example: https://demands.your-domain.com:8080/realms/demands
AUTH_ISSUER=https://demands.your-domain.com:8080/realms/demands

# JWT audience claim to validate. Must match the 'aud' in the token.
# Default: demands-api
AUTH_AUDIENCE=demands-api

# Path within the JWT payload to extract group membership
# The Keycloak protocol mapper sends group names here
# Default: groups
AUTH_GROUP_CLAIM_PATH=groups

# Group name that will grant users the ADMIN database role
# Default: admin
AUTH_ADMIN_GROUP=admin

# Group name that will grant users the MODERATOR database role
# Default: moderator
AUTH_MODERATOR_GROUP=moderator

# ============================================================================
# AUTH CLIENT SELECTOR
# ============================================================================

# Which authentication adapter to use
# Options: keycloak | custom
# Default: keycloak
AUTH_CLIENT_TYPE=keycloak

# ============================================================================
# KEYCLOAK ADMIN CLIENT (Server-to-Keycloak API calls)
# ============================================================================

# Base URL of your Keycloak server (used by the backend to fetch users/groups)
# In Docker Compose: use internal 'keycloak' hostname
# Example: http://keycloak:8080
KEYCLOAK_URL=http://keycloak:8080

# Keycloak realm name
# Must match the realm defined in the realm export JSON
# Default: demands
KEYCLOAK_REALM=demands

# Keycloak service account client ID (for admin/backend access to user management)
# This client must be marked as 'Service Account Enabled' in Keycloak
# Default: demands-api
KEYCLOAK_CLIENT_ID=demands-api

# Keycloak service account client secret. MUST be changed in production!
# Generate a new secret in the Keycloak admin console > Clients > demands-api > Credentials
# Default dev value: demands-api-secret
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# Keycloak admin console bootstrap credentials
# Used only on first container startup to create the initial admin user
# MUST be changed in production! Access the console at http://localhost:8080/admin
# Default dev values: admin / admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here

# ============================================================================
# CUSTOM AUTH CLIENT (optional, currently unused)
# ============================================================================

# If AUTH_CLIENT_TYPE=custom, provide the URL of your custom auth service
CUSTOM_AUTH_CLIENT_URL=

# If AUTH_CLIENT_TYPE=custom, provide the API key for authentication
CUSTOM_AUTH_CLIENT_API_KEY=

# ============================================================================
# FRONTEND (VITE_* — baked into the client build at compile time)
# ============================================================================

# Base URL for all backend API calls (used by Axios)
# The frontend makes all API requests to this URL
# Example: https://demands.your-domain.com:3000
VITE_API_URL=https://demands.your-domain.com:3000

# Keycloak OIDC authority/realm URL (the oidc-client-ts discovery endpoint)
# Must be the external URL accessible from the browser
# Example: https://demands.your-domain.com:8080/realms/demands
VITE_OIDC_AUTHORITY=https://demands.your-domain.com:8080/realms/demands

# Keycloak public client ID for the frontend OIDC flow
# Must be marked as 'Public' in the Keycloak admin console and have no client secret
# Default: demands-web
VITE_OIDC_CLIENT_ID=demands-web

# Redirect URI after successful login and after logout
# Must match exactly the redirect_uri in the Keycloak client configuration
# Example: https://demands.your-domain.com/callback
VITE_OIDC_REDIRECT_URI=https://demands.your-domain.com/callback
